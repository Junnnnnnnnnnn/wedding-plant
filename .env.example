# Kakao Maps (add-plen 지도)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here

# Kakao Login (백엔드 인가)
# 로그인 > Redirect URI에 아래 주소 등록 (localhost / 배포 도메인 각각)
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here

# 백엔드 API (local: http://localhost:3111)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3111
API_BASE_URL=http://localhost:3111
